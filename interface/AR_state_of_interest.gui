@soi_icon_x_pos = 360
@soi_icon_y_pos = -25
@soi_text_x_pos = 80
@soi_text_y_pos = -25

guiTypes = {
	containerWindowType = {
		name = "AR_state_of_interest"

		iconType = {
			name = "AR_state_of_interest_header"
			spriteType = GFX_state_of_interest_header
			position = { x = 0 y = -11 }
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "state_title"
			text = "[THIS.GetName]"
			font = hoi_36header
			format = center

			position = { x = @soi_text_x_pos  y = -5 }
			maxWidth = 330
			maxHeight = 30
		}

		instantTextBoxType = {
			name = "autonomy_title"
			text = autonomy_title_tt
			font = hoi_24header
			format = center

			position = { x = @soi_text_x_pos  y = 20 }
			maxWidth = 330
			maxHeight = 30
		}

		iconType = {
			name = "KR_state_of_interest_icon"
			spriteType = "GFX_empty_paper"
			position = { x = 40  y = 20 } 
			centerposition = yes
			pdx_tooltip = AR_state_of_interest_icon_tooltip
			pdx_tooltip_delayed = AR_state_of_interest_icon_tooltip_delayed
		}
	}
}

